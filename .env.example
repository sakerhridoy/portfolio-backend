# Server
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/sakerhridoy

# Auth
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# CORS - comma separated allowlist of client origins
CLIENT_ORIGIN=http://localhost:5173,http://localhost:3000

# First admin user (used by `npm run seed`)
ADMIN_EMAIL=admin@.com
ADMIN_PASSWORD=ChangeMe
ADMIN_NAME=Administrator

# Cloudinary (image uploads). Leave blank to disable the upload endpoint.
# Saker
CLOUDINARY_SAKER_CLOUD_NAME=...
CLOUDINARY_SAKER_API_KEY=...
CLOUDINARY_SAKER_API_SECRET=...
CLOUDINARY_SAKER_FOLDER=sakerhridoy

# Sumaiya
CLOUDINARY_SUMAIYA_CLOUD_NAME=...
CLOUDINARY_SUMAIYA_API_KEY=...
CLOUDINARY_SUMAIYA_API_SECRET=...
CLOUDINARY_SUMAIYA_FOLDER=sumaiyatazeen

# Email (Resend)
RESEND_API_KEY_SAKER=
RESEND_FROM_EMAIL_SAKER=
OWNER_EMAIL_SAKER=
RESEND_API_KEY_SUMAIYA=
RESEND_FROM_EMAIL_SUMAIYA=
OWNER_EMAIL_SUMAIYA=
RESEND_API_KEY=
RESEND_FROM_EMAIL=

